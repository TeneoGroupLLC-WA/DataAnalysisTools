/data/*
!/data/sample/
!/data/README.md
/output/
/outputs/
/results/
/reports/generated/
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
*.sqlite
*.sqlite3
*.db
*.duckdb
*.duckdb.wal
